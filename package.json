{
	"name": "xivi",
	"version": "0.1.0",
	"license": "MIT",
	"private": true,
	"scripts": {
		"setup": "npm i && npm prune",
		"setup-all": "npm run setup && echo \"Download Golang dependencies...\" && go install github.com/swaggo/swag/cmd/swag@latest && go get ./...",
		"upgrade": "npx npm-check-updates -u && npm run setup",
		"upgrade-all": "npx npm-check-updates -u && npm run setup && echo \"Update Golang dependencies...\" && go get -u ./...",
		"dev": "vite dev --open",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint ./src/**/*.{ts,svelte}",
		"format": "prettier --write . && go fmt ./...",
		"build": "npx vite build",
		"build-all": "swag init && npm run build && echo \"Building Golang binary...\" && CGO_ENABLED=1 go build",
		"build-all-win": "swag init && npm run build && echo \"Building Golang binary...\" && go build",
		"serve": "open-cli http://localhost:8080 && ./xivi",
		"serve-win": "open-cli http://localhost:8080 && xivi",
		"docker": "docker build . -t xivi -f Dockerfile",
		"docker-run": "open-cli http://localhost:8080 && docker run -p 8080:8080 -v serve:/serve -v config:/config --rm xivi"
	},
	"devDependencies": {
		"@iconify/svelte": "^3.1.6",
		"@skeletonlabs/skeleton": "^2.8.0",
		"@skeletonlabs/tw-plugin": "^0.3.1",
		"@sveltejs/kit": "^2.5.0",
		"@tailwindcss/forms": "^0.5.7",
		"@types/node": "^20.11.19",
		"@typescript-eslint/eslint-plugin": "^7.0.1",
		"@typescript-eslint/parser": "^7.0.1",
		"autoprefixer": "^10.4.17",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"npm-check-updates": "^16.14.15",
		"open-cli": "^8.0.0",
		"postcss": "^8.4.35",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.1",
		"prettier-plugin-tailwindcss": "^0.5.11",
		"svelte": "^4.2.11",
		"svelte-check": "^3.6.4",
		"svelte-dnd-action": "^0.9.38",
		"svelte-preprocess": "^5.1.3",
		"tailwindcss": "^3.4.1",
		"tslib": "^2.6.2",
		"typescript": "^5.3.3",
		"unplugin-icons": "^0.18.5",
		"vite": "^5.1.3"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.6.3",
		"@sveltejs/adapter-static": "^3.0.1",
		"axios": "^1.6.7",
		"bootstrap": "^5.3.2",
		"vidstack": "^1.10.5"
	}
}
