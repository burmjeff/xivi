{
	"name": "xivi",
	"version": "0.1.0",
	"license": "MIT",
	"private": true,
	"scripts": {
		"setup": "npm i && npm prune",
		"setup-all": "npm run setup && echo \"Download Golang dependencies...\" && go install github.com/swaggo/swag/cmd/swag@latest && go get ./...",
		"upgrade": "npx npm-check-updates -u && npm run setup",
		"upgrade-all": "npx npm-check-updates -u && npm run setup && echo \"Update Golang dependencies...\" && go get -u ./...",
		"dev": "vite dev --open",
		"dev:debug": "vite dev --debug hmr --open",
		"dev:force": "vite dev --force --open",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint ./src/**/*.{ts,svelte}",
		"format": "prettier --write . && go fmt ./...",
		"build": "npx vite build",
		"build-all": "swag init && npm run build && echo \"Building Golang binary...\" && CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -ldflags \"-linkmode 'external' -extldflags '-lstdc++ -lssl -lcrypto' -s -w\" -buildvcs=false -mod=readonly -v -o xivi .",
		"build-all-win": "swag init && npm run build && echo \"Building Golang binary...\" && go build -ldflags \"-linkmode 'external' -extldflags '-lstdc++ -lssl -lcrypto' -s -w\" -buildvcs=false -mod=readonly -v -o xivi .",
		"serve": "./xivi",
		"serve-win": "open-cli http://localhost:3000 && xivi",
		"docker": "docker build . -t xivi -f Dockerfile",
		"docker-run": "open-cli http://localhost:3000 && docker run -p 3000:3000 -v serve:/xivi/serve -v config:/xivi/config --rm xivi"
	},
	"devDependencies": {
		"@iconify/svelte": "^5.1.0",
		"@skeletonlabs/skeleton": "^4.5.0",
		"@skeletonlabs/skeleton-svelte": "^4.5.0",
		"@sveltejs/kit": "^2.49.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/node": "^24.10.1",
		"@typescript-eslint/eslint-plugin": "^8.47.0",
		"@typescript-eslint/parser": "^8.47.0",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"npm-check-updates": "^19.1.2",
		"open-cli": "^8.0.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.43.14",
		"svelte-check": "^4.3.4",
		"svelte-dnd-action": "^0.9.67",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^4.1.17",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"unplugin-icons": "^22.5.0",
		"vite": "^7.2.4"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.7.4",
		"@skeletonlabs/floating-ui-svelte": "^0.3.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@tailwindcss/vite": "^4.1.17",
		"axios": "^1.13.2",
		"castable-video": "^1.1.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hls.js": "^1.6.15",
		"media-chrome": "^4.16.0",
		"media-icons": "^1.1.5",
		"tailwind-merge": "^3.4.0"
	}
}
