{
	"name": "xivi",
	"version": "0.1.0",
	"license": "MIT",
	"private": true,
	"scripts": {
		"setup": "npm i && npm prune",
		"setup-all": "npm run setup && echo \"Download Golang dependencies...\" && go install github.com/swaggo/swag/cmd/swag@latest && go get ./...",
		"upgrade": "npx npm-check-updates -u && npm run setup",
		"upgrade-all": "npx npm-check-updates -u && npm run setup && echo \"Update Golang dependencies...\" && go get -u ./...",
		"dev": "vite dev --open",
		"dev:debug": "vite dev --debug hmr --open",
		"dev:force": "vite dev --force --open",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint ./src/**/*.{ts,svelte}",
		"format": "prettier --write . && go fmt ./...",
		"build": "npx vite build",
		"build-all": "swag init && npm run build && echo \"Building Golang binary...\" && CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -ldflags \"-linkmode 'external' -extldflags '-lstdc++ -lssl -lcrypto' -s -w\" -buildvcs=false -mod=readonly -v -o xivi .",
		"build-all-win": "swag init && npm run build && echo \"Building Golang binary...\" && go build -ldflags \"-linkmode 'external' -extldflags '-lstdc++ -lssl -lcrypto' -s -w\" -buildvcs=false -mod=readonly -v -o xivi .",
		"serve": "./xivi",
		"serve-win": "open-cli http://localhost:3000 && xivi",
		"docker": "docker build . -t xivi -f Dockerfile",
		"docker-run": "open-cli http://localhost:3000 && docker run -p 3000:3000 -v serve:/xivi/serve -v config:/xivi/config --rm xivi"
	},
	"devDependencies": {
		"@iconify/svelte": "^5.0.0",
		"@skeletonlabs/skeleton": "^3.1.3",
		"@skeletonlabs/skeleton-svelte": "^1.2.3",
		"@sveltejs/kit": "^2.21.5",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.10",
		"@types/node": "^24.0.1",
		"@typescript-eslint/eslint-plugin": "^8.34.0",
		"@typescript-eslint/parser": "^8.34.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.2",
		"npm-check-updates": "^18.0.1",
		"open-cli": "^8.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.12",
		"svelte": "^5.34.5",
		"svelte-check": "^4.2.1",
		"svelte-dnd-action": "^0.9.61",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^4.1.10",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"unplugin-icons": "^22.1.0",
		"vite": "^6.3.5"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.7.1",
		"@skeletonlabs/floating-ui-svelte": "^0.3.9",
		"@sveltejs/adapter-static": "^3.0.8",
		"@tailwindcss/vite": "^4.1.10",
		"axios": "^1.10.0",
		"bootstrap": "^5.3.6",
		"castable-video": "^1.1.10",
		"hls.js": "^1.6.5",
		"media-chrome": "^4.11.1",
		"media-icons": "^1.1.5"
	}
}
