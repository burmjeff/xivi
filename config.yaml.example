application:
  appname: Xivi
  appversion: 1.0
  tz: America/New_York
  loglevel: 3
  updatecron: "0 0 * * *"

server:
  host: 127.0.0.1
  port: 3000
  readtimeout: 60

playlist:
  tvgid_match: true
  name_match: true
  name_score: 0.96

streaming:
  type: mp2t
  proxy: true
  buffer: 1
  retryEOS: 10
  useragent: Xivi 1.0

vector:
  batch_size: 100
  parallel_batches: 10
  timeout: 90
  cache_size: 500

upnp:
  enabled: true
  manufacturer: XIVI
  model_name: XIVI-SSDP
  model_number: XIVI-SSDP
  firmware_name: xivi_ssdp
  firmware_version: "20250101"
  device_auth: "123456"
  tuner_count: 6
