application:
  appname: Xivi
  appversion: 1.0
  tz: America/New_York
  loglevel: 3
  # App-owned and hot-reloaded from Studio; there is no environment override.
  updatecron: '0 0 * * *'

server:
  host: 127.0.0.1
  port: 3000
  readtimeout: 60

playlist:
  tvgid_match: true
  name_match: true
  name_score: 0.96

streaming:
  proxy: true
  ingest_buffer_ms: 750
  startup_timeout_seconds: 12
  startup_hedge_ms: 750
  stall_timeout_seconds: 5
  hedge_timeout_seconds: 3
  idle_timeout_seconds: 45
  retry_limit: 6
  retry_backoff_ms: 500
  hls_segment_seconds: 1
  hls_playlist_length: 8
  hls_compatibility_mode: true
  client_buffer_mb: 2
  prewarm_channels: 2
  # These protect downstream capacity without limiting HLS segment requests.
  max_concurrent_streams_per_user: 8
  max_concurrent_streams_per_key: 4
  stream_starts_per_minute: 20
  tls_verify: true
  useragent: Xivi 1.0

vector:
  batch_size: 100
  parallel_batches: 10
  timeout: 90
  cache_size: 500

maintenance:
  # App-owned and hot-reloaded from Studio; there is no environment override.
  cleanup_interval_hours: 6
  operation_job_retention_days: 30
  stream_diagnostics_days: 14
  maximum_operation_jobs: 2000
  maximum_stream_sessions: 2000

virtual_tuner:
  tuner_count: 6

# The authentication key is not stored in YAML or SQLite. Xivi creates it at
# /xivi/config/auth.key on first startup unless XIVI_AUTH_KEY_FILE overrides it.
security:
  # Optional. Leave both public URLs blank for a local-only production deployment.
  public_base_url: ''
  # Optional separate key-authenticated hostname for players; defaults to public_base_url.
  public_media_base_url: ''
  local_base_url: http://192.168.1.10:3000
  trusted_proxy_cidrs:
    - 192.168.1.20/32
  # Optional alternative for a proxy on the same user-defined Docker network.
  # Public DNS results are ignored; use a CIDR for non-private proxy peers.
  trusted_proxy_hosts: []
  # Optional. When empty, direct loopback and private-network clients are trusted.
  trusted_lan_cidrs: []
  allow_lan_http: true
  audit_retention_days: 90
  maximum_audit_events: 100000
