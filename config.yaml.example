application:
  appname: Xivi
  appversion: 1.0
  tz: America/New_York
  loglevel: 3
  updatecron: "0 0 * * *"

server:
  host: 127.0.0.1
  port: 3000
  readtimeout: 60

playlist:
  tvgid_match: true
  name_match: true
  name_score: 0.96

streaming:
  proxy: true
  ingest_buffer_ms: 750
  startup_timeout_seconds: 12
  startup_hedge_ms: 750
  stall_timeout_seconds: 5
  hedge_timeout_seconds: 3
  idle_timeout_seconds: 45
  retry_limit: 6
  retry_backoff_ms: 500
  hls_segment_seconds: 1
  hls_playlist_length: 8
  hls_compatibility_mode: true
  client_buffer_mb: 2
  prewarm_channels: 2
  tls_verify: true
  useragent: Xivi 1.0

vector:
  batch_size: 100
  parallel_batches: 10
  timeout: 90
  cache_size: 500

maintenance:
  cleanup_interval_hours: 6
  operation_job_retention_days: 30
  stream_diagnostics_days: 14
  maximum_operation_jobs: 2000
  maximum_stream_sessions: 2000

virtual_tuner:
  tuner_count: 6
