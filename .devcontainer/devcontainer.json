// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "xivi-dev",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"target": "development"
	},
	"forwardPorts": [3000, 5173],
	"portsAttributes": {
		"3000": {
			"label": "Xivi API",
			"onAutoForward": "notify"
		},
		"5173": {
			"label": "Xivi Vite",
			"onAutoForward": "notify"
		}
	},
	"mounts": [
		"source=xivi-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume,volume-nocopy",
		"source=xivi-vite-cache,target=${containerWorkspaceFolder}/.vite,type=volume,volume-nocopy",
		"source=xivi-svelte-kit,target=${containerWorkspaceFolder}/.svelte-kit,type=volume,volume-nocopy",
		"source=xivi-stream-cache,target=${containerWorkspaceFolder}/serve/stream,type=volume,volume-nocopy",
		"source=xivi-npm-cache,target=/home/ubuntu/.npm,type=volume,volume-nocopy"
	],
	"postCreateCommand": "sudo chown -R ubuntu:ubuntu node_modules .vite .svelte-kit serve/stream /home/ubuntu/.npm && npm ci && go mod download && go install github.com/swaggo/swag/cmd/swag@latest && gst-inspect-1.0 --version",
	"containerEnv": {
		"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
		"GITHUB_USER": "${localEnv:GITHUB_USER}"
	},
	"runArgs": ["--name=xivi-dev"],
	"remoteUser": "ubuntu"

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
