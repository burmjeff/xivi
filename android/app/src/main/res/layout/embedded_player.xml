<?xml version="1.0" encoding="utf-8"?>
<com.xivi.app.MiniPlayerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_stage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:surface_type="texture_view"
        app:show_buffering="when_playing" />
    <Button
        android:id="@+id/player_pip"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/player_pip"
        android:text="PiP"
        android:textColor="#FFFFFF"
        android:backgroundTint="#99000000" />
    <ProgressBar
        android:id="@+id/player_connecting"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:contentDescription="@string/player_connecting" />
    <LinearLayout
        android:id="@+id/player_error_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp"
        android:background="#E6080A0F"
        android:visibility="gone">
        <TextView
            android:id="@+id/player_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F7F7F2"
            android:textSize="14sp"
            android:accessibilityLiveRegion="polite" />
        <Button
            android:id="@+id/player_retry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/player_retry"
            android:backgroundTint="#FF6B5E"
            android:textColor="#080A0F" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/player_mini_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:padding="14dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#FFFFFF"
        android:background="#55000000"
        android:contentDescription="@string/player_mini_close"
        android:visibility="gone" />
</com.xivi.app.MiniPlayerLayout>
